# ==== LLM 服务商 (二选一) ====

# 方式1: Anthropic (Claude) — 推荐
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 方式2: OpenAI 兼容 (GPT/DeepSeek/Qwen/Ollama 等)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com      # 留空=OpenAI官方
# LLM_MODEL_OVERRIDE=deepseek-chat               # 可选: 统一指定模型名

# ==== 数据源 (可选) ====
# Tushare Token (A股数据)
TUSHARE_TOKEN=your_tushare_token_here

# News API Key (新闻增强)
NEWS_API_KEY=your_newsapi_key_here
