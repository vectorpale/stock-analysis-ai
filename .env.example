# ==== LLM 服务商 (三选一) ====

# 方式1: 通义千问 Qwen (默认推荐，注册即送免费额度)
# 获取 Key: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 方式2: Anthropic Claude (备选)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 方式3: 其他 OpenAI 兼容 (GPT/DeepSeek/Ollama 等)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com      # 留空=OpenAI官方
# LLM_MODEL_OVERRIDE=deepseek-chat               # 可选: 统一指定模型名

# ==== 数据源 ====

# Financial Modeling Prep (推荐，美股数据更稳定)
# 免费注册: https://site.financialmodelingprep.com/developer/docs
# FMP_API_KEY=your_fmp_api_key_here

# Tushare Token (A股数据)
# TUSHARE_TOKEN=your_tushare_token_here

# News API Key (新闻增强)
# NEWS_API_KEY=your_newsapi_key_here
